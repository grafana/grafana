{
  extends: ["config:recommended", "security:gomodIndirectSecurityUpdates", "group:goOpenapi"],
  enabledManagers: ["npm", "docker-compose", "gomod", "github-actions"],
  ignorePresets: [
    "github>grafana/grafana-renovate-config//presets/labels",
  ],
  ignoreDeps: [
    "@types/history", // this can be removed entirely when we upgrade history since v5 exposes types directly
    "history", // we should bump this together with react-router-dom (see https://github.com/grafana/grafana/issues/76744)
    "react-router", // we should bump this together with history and react-router-dom
    "react-router-dom", // we should bump this together with history (see https://github.com/grafana/grafana/issues/76744)
    "monaco-editor", // due to us exposing this via @grafana/ui/CodeEditor's props bumping can break plugins
    "@fingerprintjs/fingerprintjs", // we don't want to bump to v4 due to licensing changes
    "slate", // we don't want to continue using this on the long run, use Monaco editor instead of Slate
    "slate-react", // we don't want to continue using this on the long run, use Monaco editor instead of Slate
    "@types/slate-react", // we don't want to continue using this on the long run, use Monaco editor instead of Slate
    "@types/slate", // we don't want to continue using this on the long run, use Monaco editor instead of Slate
  ],
  includePaths: [
    "package.json", "packages/**", "public/app/plugins/**", "devenv/frontend-service/docker-compose.yaml",
    "go.mod", ".citools/**/go.mod",
    ".github/workflows/**", ".github/actions/**", "pkg/build/actions/**",
  ],
  ignorePaths: ["emails/**", "**/mocks/**"],
  labels: ["area/frontend", "dependencies", "no-changelog"],
  postUpdateOptions: ["pnpmDedupe"],
  packageRules: [
    {
      automerge: true,
      matchManagers: ["npm"],
      matchCurrentVersion: "!/^0/",
      matchUpdateTypes: ["patch"],
      matchPackageNames: ["!/^@?storybook/", "!/^@locker/", "!/^@grafana/"],
      minimumReleaseAge: "7 days",
    },
    {
      automerge: true,
      matchManagers: ["npm"],
      matchCurrentVersion: "!/^0/",
      matchUpdateTypes: ["patch"],
      matchPackageNames: ["/^@grafana/"],
    },
    {
      extends: ["schedule:monthly"],
      groupName: "Storybook updates",
      matchPackageNames: ["/^@?storybook/"],
      rangeStrategy: "bump",
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "React Aria",
      matchPackageNames: ["@react-aria/{/,}**", "@react-stately/{/,}**"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "Moveable",
      matchPackageNames: ["moveable", "react-moveable"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "Slate",
      matchPackageNames: ["@types/slate", "@types/slate-react", "slate", "slate-react"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "d3",
      matchPackageNames: ["d3{/,}**", "@types/d3{/,}**"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "scenes",
      matchPackageNames: ["@grafana/scenes", "@grafana/scenes-react"],
    },
    {
      groupName: "faro",
      matchPackageNames: ["@grafana/faro*"],
    },
    {
      groupName: "visx",
      matchPackageNames: ["@visx/{/,}**"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "uLibraries",
      matchPackageNames: ["@leeoniya/**", "uplot"],
      reviewers: ["leeoniya"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "locker",
      reviewers: ["team:grafana/grafana-catalog"],
      matchPackageNames: ["@locker/{/,}**"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "augurs",
      matchPackageNames: ["@bsull/augurs"],
      reviewers: ["sd2k"],
      minimumReleaseAge: "7 days",
    },
    {
      groupName: "nx",
      matchPackageNames: ["nx", "@nx/{/,}**"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Run Meticulous for production dependencies used by the Grafana UI",
      matchManagers: ["npm"],
      matchDepTypes: ["dependencies"],
      matchFileNames: [
        "package.json",
        "packages/grafana-alerting/package.json",
        "packages/grafana-api-clients/package.json",
        "packages/grafana-data/package.json",
        "packages/grafana-flamegraph/package.json",
        "packages/grafana-i18n/package.json",
        "packages/grafana-o11y-ds-frontend/package.json",
        "packages/grafana-runtime/package.json",
        "packages/grafana-sql/package.json",
        "packages/grafana-ui/package.json",
        "public/app/plugins/**/package.json",
      ],
      addLabels: ["ci/meticulous"],
    },
    {
      matchDepTypes: ["devDependencies"],
      prPriority: -1,
    },
    {
      matchManagers: ["gomod"],
      automerge: false,
      labels: ["area/backend", "dependencies", "no-changelog"],
      reviewers: [],
    },
    {
      matchManagers: ["github-actions"],
      automerge: false,
      labels: ["dependencies", "no-changelog"],
      reviewers: [],
    },
    {
      description: "Group indirect Go dependencies of the root module",
      matchManagers: ["gomod"],
      matchFileNames: ["go.mod"],
      matchDepTypes: ["indirect"],
      groupName: "Go indirect dependencies",
      schedule: ["before 6am on monday"],
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["cloud.google.com/go/**", "google.golang.org/api", "google.golang.org/genproto/**", "github.com/googleapis/gax-go/**"],
      groupName: "Google Cloud Go",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["golang.org/x/**"],
      groupName: "golang.org/x",
      groupSlug: "golang-x",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/prometheus/client_golang", "github.com/prometheus/common"],
      groupName: "Prometheus client libraries",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/openfga/**"],
      groupName: "openfga",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["go.etcd.io/etcd/**"],
      groupName: "etcd",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/blevesearch/**"],
      groupName: "bleve",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/nats-io/**"],
      groupName: "nats",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/redis/go-redis/**"],
      groupName: "go-redis",
    },
    {
      description: "Group github.com/grafana Go modules by the team that owns them in go.mod",
      matchManagers: ["gomod"],
      matchPackageNames: [
        "github.com/grafana/alerting",
        "github.com/grafana/alerting/apps/historian",
        "github.com/grafana/grafana-api-golang-client",
        "github.com/grafana/loki/pkg/push",
      ],
      groupName: "Go modules owned by alerting-backend",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/grafana/authlib", "github.com/grafana/authlib/types", "github.com/grafana/saml"],
      groupName: "Go modules owned by identity-access-team",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/grafana/dataplane/examples", "github.com/grafana/dataplane/sdata"],
      groupName: "Go modules owned by observability-metrics",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/grafana/dskit", "github.com/grafana/grafana-openapi-client-go"],
      groupName: "Go modules owned by grafana-backend-group",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/grafana/e2e", "github.com/grafana/grafana-app-sdk", "github.com/grafana/grafana-app-sdk/logging"],
      groupName: "Go modules owned by grafana-app-platform-squad",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/grafana/gomemcache", "github.com/grafana/grafana-cloud-migration-snapshot"],
      groupName: "Go modules owned by grafana-operator-experience-squad",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "github.com/grafana/grafana-aws-sdk",
        "github.com/grafana/grafana-azure-sdk-go/v2",
        "github.com/grafana/grafana-google-sdk-go",
        "github.com/grafana/pyroscope-go/godeltaprof",
        "github.com/grafana/tempo",
      ],
      groupName: "Go modules owned by data-sources-plugins",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/grafana/nanogit", "github.com/grafana/nanogit/gittest"],
      groupName: "Go modules owned by grafana-git-ui-sync-team",
    },
    {
      description: "Group Go CI tool dependencies, after the package groups above so tool updates stay in this group",
      matchManagers: ["gomod"],
      matchFileNames: [".citools/**"],
      groupName: "Go CI tools",
      schedule: ["before 6am on monday"],
    },
    {
      matchManagers: ["gomod", "github-actions"],
      matchUpdateTypes: ["major", "minor", "patch", "pin", "digest", "pinDigest", "lockFileMaintenance", "rollback", "replacement"],
      enabled: false,
    },
  ],
  osvVulnerabilityAlerts: true,
  pin: {
    enabled: false,
  },
  prConcurrentLimit: 10,
  rebaseWhen: "conflicted",
  reviewers: ["team:grafana/grafana-frontend-platform"],
  separateMajorMinor: false,
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["area/security"],
  },
}
