{
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "name": "@grafana/plugin-compat",
  "version": "0.2.0",
  "private": true,
  "description": "Compatibility shims that let Grafana plugins adopt new Grafana host APIs across a range of host versions",
  "keywords": [
    "grafana",
    "typescript",
    "plugins"
  ],
  "sideEffects": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "http://github.com/grafana/grafana.git",
    "directory": "packages/grafana-plugin-compat"
  },
  "main": "./dist/cjs/datasources.cjs",
  "module": "./dist/esm/datasources.mjs",
  "exports": {
    "./package.json": "./package.json",
    "./datasources": {
      "@grafana-app/source": "./src/datasources.ts",
      "import": {
        "types": "./dist/esm/datasources.d.mts",
        "default": "./dist/esm/datasources.mjs"
      },
      "require": {
        "types": "./dist/cjs/datasources.d.cts",
        "default": "./dist/cjs/datasources.cjs"
      }
    },
    "./apps": {
      "@grafana-app/source": "./src/apps.ts",
      "import": {
        "types": "./dist/esm/apps.d.mts",
        "default": "./dist/esm/apps.mjs"
      },
      "require": {
        "types": "./dist/cjs/apps.d.cts",
        "default": "./dist/cjs/apps.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE_APACHE2"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "clean": "rimraf ./dist ./compiled ./package.tgz",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit",
    "prepack": "cp package.json package.json.bak && node ../../scripts/prepare-npm-package.js",
    "postpack": "mv package.json.bak package.json"
  },
  "devDependencies": {
    "@grafana/data": "workspace:*",
    "@grafana/runtime": "workspace:*",
    "@grafana/schema": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.0.1",
    "rolldown": "1.2.9",
    "rolldown-plugin-dts": "0.28.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@grafana/data": ">=12.0.0",
    "@grafana/runtime": ">=12.0.0",
    "@grafana/schema": ">=12.0.0",
    "react": ">=18"
  }
}
