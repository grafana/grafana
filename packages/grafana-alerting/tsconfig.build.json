{
  "compilerOptions": {
    // rolldown-plugin-dts writes declarations to its own output directory, which declarationDir would override.
    "declarationDir": null,
    "rootDir": "./src"
  },
  "exclude": ["dist", "node_modules", "tests", "**/*.test.ts*", "**/*.story.tsx"],
  "extends": "./tsconfig.json"
}
