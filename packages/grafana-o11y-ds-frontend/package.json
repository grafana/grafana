{
  "author": "Grafana Labs",
  "license": "AGPL-3.0-only",
  "name": "@grafana/o11y-ds-frontend",
  "version": "13.4.0-pre",
  "description": "Shared UI components and utilities for observability datasource plugins in Grafana.",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "http://github.com/grafana/grafana.git",
    "directory": "packages/grafana-o11y-ds-frontend"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.cts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@grafana-app/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE_AGPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "clean": "rimraf ./dist ./compiled ./package.tgz",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "workspace:*",
    "@grafana/e2e-selectors": "workspace:*",
    "@grafana/plugin-compat": "workspace:^",
    "@grafana/plugin-ui": "^0.17.3",
    "@grafana/runtime": "workspace:*",
    "@grafana/ui": "workspace:*",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.1.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^29.5.4",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/systemjs": "^6.15.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^29.6.4",
    "react": "19.2.8",
    "rolldown": "1.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
