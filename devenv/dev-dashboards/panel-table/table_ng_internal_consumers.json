                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "csv_content",
                        "csvContent": "Host,Region,Status,Latency ms\nweb-01,eu-west,up,12.5\nweb-02,us-east,down,250\ndb-01,ap-south,up,48.2\ncache-01,eu-west,degraded,99.9"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "indexByName": {},
                      "includeByName": {},
                      "renameByName": {
                        "Host": "Hostname",
                        "Latency ms": "Latency (ms)"
                      }
