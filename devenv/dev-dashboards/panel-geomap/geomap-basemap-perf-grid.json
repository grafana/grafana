      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "CARTO positron · 10k markers · $copy",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "random_walk",
                        "startValue": 39,
                        "spread": 0.25,
                        "min": -85,
                        "max": 85,
                        "seriesCount": 1
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "random_walk",
                        "startValue": -98,
                        "spread": 0.25,
                        "min": -180,
                        "max": 180,
                        "seriesCount": 2
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "random_walk",
                        "startValue": 50,
                        "spread": 10,
                        "min": 0,
                        "max": 100,
                        "seriesCount": 3
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "joinByField",
                  "spec": {
                    "id": "joinByField",
                    "options": {
                      "byField": "time",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {
                        "B-series": true,
                        "C-series": true,
                        "C-series1": true
                      },
                      "renameByName": {
                        "A-series": "lat",
                        "B-series1": "lon",
                        "C-series2": "value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "maxDataPoints": 10000
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.3.0-pre",
            "spec": {
              "options": {
                "basemap": {
                  "type": "carto",
                  "name": "Basemap",
                  "config": {
                    "theme": "light",
                    "showLabels": true
                  }
                },
                "controls": {
                  "mouseWheelZoom": true,
                  "showAttribution": true,
                  "showDebug": false,
                  "showMeasure": false,
                  "showScale": false,
                  "showZoom": true
                },
                "layers": [
                  {
                    "type": "markers",
                    "name": "10k markers",
                    "location": {
                      "mode": "coords",
                      "latitude": "lat",
                      "longitude": "lon"
                    },
                    "config": {
                      "showLegend": false,
                      "style": {
                        "color": {
                          "field": "value",
                          "fixed": "dark-green"
                        },
                        "opacity": 0.6,
                        "size": {
                          "fixed": 3,
                          "min": 2,
                          "max": 6
                        },
                        "symbol": {
                          "mode": "fixed",
                          "fixed": "img/icons/marker/circle.svg"
                        }
                      }
