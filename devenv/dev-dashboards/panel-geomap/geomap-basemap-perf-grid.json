{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "geomap-basemap-perf-grid"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "16 copies of one basemap on the same view, to measure cost that grows with panel count. Pick fewer values of the Copies variable for a smaller grid. Needs the grafana.geomapProtomapsBasemap feature flag and a Protomaps tile server on localhost:8095. Rows are collapsed so only the row under test renders; open one panel at a time with viewPanel for single-panel runs. Data layers use 10,000-point TestData random walks around each view, enough to spot large regressions but too small for benchmark numbers.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "CARTO positron · No data · $copy",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.3.0-pre",
            "spec": {
              "options": {
                "basemap": {
                  "type": "carto",
                  "name": "Basemap",
                  "config": {
                    "theme": "light",
                    "showLabels": true
                  }
                },
                "controls": {
                  "mouseWheelZoom": true,
                  "showAttribution": true,
                  "showDebug": false,
                  "showMeasure": false,
                  "showScale": false,
                  "showZoom": true
                },
                "layers": [],
                "tooltip": {
                  "mode": "details"
                },
                "view": {
                  "id": "coords",
                  "lat": 39,
                  "lon": -98,
                  "zoom": 5,
                  "shared": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "continuous-GrYlRd"
                  }
                },
                "overrides": []
