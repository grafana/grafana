      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Compare with per-query opt-out",
          "description": "Queries refId C and refId D, where D opts out via timeRangeCompare. Expect the compare request to carry C-compare only.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
