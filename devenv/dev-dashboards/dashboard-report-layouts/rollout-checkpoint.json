            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "value",
                "justifyMode": "auto",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "rollout-progress": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Rollout progress by wave",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "random_walk",
                        "seriesCount": 3,
                        "min": 0,
                        "max": 100,
                        "startValue": 40
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "custom": {
                    "lineWidth": 2,
                    "fillOpacity": 8
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "checkpoint-note": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Checkpoint note",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Hold at wave 3.** Error budgets held through waves 1 and 2, but wave 3 adds the first multi-tenant clusters.\n\n- Proceed when wave 3 holds above **90%** for two days.\n- Roll back if `layout_render_errors` exceeds the wave 2 baseline.\n\nRead the chart for *trend*, not readiness.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "textStyle": "editorial"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "baseline-note": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Baseline",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "The baseline is the **last stable build** before the Rspack migration. Rspack measurements are reported separately and are not part of this comparison.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "textStyle": "editorial"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "entrypoint-change": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Entrypoint size change",
          "description": "Main entrypoint, compressed.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "csv_metric_values",
                        "stringInput": "2.31,2.28,2.30,2.12,2.05,2.07",
                        "alias": "Entrypoint size change"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "value",
                "justifyMode": "auto",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decmbytes",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "live-errors": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Render errors",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "random_walk",
                        "seriesCount": 2,
                        "min": 0,
                        "max": 100,
                        "startValue": 40
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
