          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "csv_metric_values",
                        "stringInput": "0,5,22,48,63,71",
                        "alias": "Wave 2 coverage"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "value",
                "justifyMode": "auto",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "wave-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Wave 3 coverage",
          "description": "Clusters on the new layout engine, wave 3.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "csv_metric_values",
