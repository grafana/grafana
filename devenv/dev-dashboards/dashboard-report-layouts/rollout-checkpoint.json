{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "report-layouts-rollout"
  },
  "spec": {
    "title": "Rollout checkpoint (report layouts)",
    "description": "Fixture for report sections, editorial prose, and the responsive split. Fictional data.",
    "annotations": [],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "wave-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Wave 1 coverage",
          "description": "Clusters on the new layout engine, wave 1.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-testdata-datasource",
                      "version": "v0",
                      "spec": {
                        "scenarioId": "csv_metric_values",
                        "stringInput": "12,40,71,88,96,98",
                        "alias": "Wave 1 coverage"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "value",
                "justifyMode": "auto",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "wave-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Wave 2 coverage",
          "description": "Clusters on the new layout engine, wave 2.",
