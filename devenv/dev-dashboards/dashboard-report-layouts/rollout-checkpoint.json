    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Wave coverage",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 3,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "short",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "wave-1"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "wave-2"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "wave-3"
                        }
                      }
                    }
                  ]
                }
              },
              "headerStyle": "report",
              "summary": "Waves 1 and 2 are nearly complete. Coverage alone does **not** establish readiness; the checkpoint below does."
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Rollout checkpoint",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "rollout-progress"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "checkpoint-note"
                        }
                      }
                    }
                  ],
                  "columnLayout": "split-wide-first"
                }
              },
              "headerStyle": "report",
              "summary": "This is the decision point for wave 3. The note beside the chart records what the review agreed, so the reading travels with the evidence."
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Baseline and comparison",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "baseline-note"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "entrypoint-change"
                        }
                      }
                    }
                  ],
                  "columnLayout": "split-wide-second"
                }
              },
              "headerStyle": "report",
              "summary": "Read the baseline first, then the change. See the [rollout runbook](/dashboards) for how the baseline was chosen."
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Live context",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 3,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "live-errors"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "live-latency"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "live-saturation"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": ["report-layouts"],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": []
  }
}
