      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Status list: Handlebars picks the token",
          "description": "Handlebars runs first, so its output can contain the macro",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-testdata-datasource",
                      "datasource": {
                        "name": "PD8C576611E62080A"
                      },
                      "spec": {
                        "scenarioId": "csv_content",
                        "csvContent": "service,status,latency_ms\ncheckout,up,182\npayments,down,0\nsearch,degraded,941\ninventory,up,95\nnotifications,degraded,612\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.2.0-local",
            "spec": {
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "<p style=\"color: ${__theme.colors.text.secondary}\">\n  Handlebars picks the token, then the macro resolves it: <code>&#123;&#123;#if (eq status \"up\")&#125;&#125; ... $&#123;__theme.colors.success.text&#125;</code>\n</p>\n{{#each data}}\n<div style=\"display: flex; gap: 12px; align-items: center; margin-bottom: 8px; padding: 8px 12px; background: ${__theme.colors.background.secondary}; border: 1px solid ${__theme.colors.border.weak}; border-radius: ${__theme.shape.radius.default}\">\n  <strong style=\"flex-grow: 1\">{{service}}</strong>\n  <span style=\"font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.text.secondary}\">{{latency_ms}} ms</span>\n  {{#if (eq status \"up\")}}\n  <span style=\"padding: 2px 10px; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.success.text}; background: ${__theme.colors.success.transparent}; border: 1px solid ${__theme.colors.success.border}; border-radius: ${__theme.shape.radius.pill}\">up</span>\n  {{/if}}\n  {{#if (eq status \"degraded\")}}\n  <span style=\"padding: 2px 10px; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.warning.text}; background: ${__theme.colors.warning.transparent}; border: 1px solid ${__theme.colors.warning.border}; border-radius: ${__theme.shape.radius.pill}\">degraded</span>\n  {{/if}}\n  {{#if (eq status \"down\")}}\n  <span style=\"padding: 2px 10px; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.error.text}; background: ${__theme.colors.error.transparent}; border: 1px solid ${__theme.colors.error.border}; border-radius: ${__theme.shape.radius.pill}\">down</span>\n  {{/if}}\n</div>\n{{/each}}\n",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Callouts in Markdown",
          "description": "colors.<color>.transparent / border / text",
