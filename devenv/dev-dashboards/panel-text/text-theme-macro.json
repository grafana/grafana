                "content": "<div style=\"padding: 12px; background: ${__theme.colors.background.canvas}; border: 1px solid ${__theme.colors.border.medium}; border-radius: ${__theme.shape.radius.default}\">\n  <div style=\"font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.text.secondary}; margin-bottom: 8px\">background.canvas</div>\n  <div style=\"padding: 12px; background: ${__theme.colors.background.primary}; border: 1px solid ${__theme.colors.border.medium}; border-radius: ${__theme.shape.radius.default}\">\n    <div style=\"font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.text.secondary}; margin-bottom: 8px\">background.primary</div>\n    <div style=\"padding: 12px; background: ${__theme.colors.background.secondary}; border: 1px solid ${__theme.colors.border.medium}; border-radius: ${__theme.shape.radius.default}\">\n      <div style=\"font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.text.secondary}; margin-bottom: 8px\">background.secondary</div>\n      <div style=\"color: ${__theme.colors.text.primary}\">text.primary</div>\n      <div style=\"color: ${__theme.colors.text.secondary}\">text.secondary</div>\n      <div style=\"color: ${__theme.colors.text.disabled}\">text.disabled</div>\n      <div style=\"color: ${__theme.colors.text.link}\">text.link</div>\n      <div style=\"color: ${__theme.colors.text.maxContrast}\">text.maxContrast</div>\n      <div style=\"display: flex; gap: 8px; align-items: center; margin-top: 12px\">\n        <div style=\"flex-grow: 1; flex-basis: 0; padding: 8px; text-align: center; border: 2px solid ${__theme.colors.border.weak}; border-radius: ${__theme.shape.radius.default}\">border.weak</div>\n        <div style=\"flex-grow: 1; flex-basis: 0; padding: 8px; text-align: center; border: 2px solid ${__theme.colors.border.medium}; border-radius: ${__theme.shape.radius.default}\">border.medium</div>\n        <div style=\"flex-grow: 1; flex-basis: 0; padding: 8px; text-align: center; border: 2px solid ${__theme.colors.border.strong}; border-radius: ${__theme.shape.radius.default}\">border.strong</div>\n      </div>\n    </div>\n  </div>\n</div>\n",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
