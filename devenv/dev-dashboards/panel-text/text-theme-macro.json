      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Typography",
          "description": "typography.size.<size> and typography.fontWeight<weight>",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.2.0-local",
            "spec": {
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">size.xs</div>\n  <div style=\"font-size: ${__theme.typography.size.xs}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.size.xs}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">size.sm</div>\n  <div style=\"font-size: ${__theme.typography.size.sm}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.size.sm}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">size.md</div>\n  <div style=\"font-size: ${__theme.typography.size.md}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.size.md}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">size.lg</div>\n  <div style=\"font-size: ${__theme.typography.size.lg}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.size.lg}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">fontWeightLight</div>\n  <div style=\"font-weight: ${__theme.typography.fontWeightLight}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.fontWeightLight}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">fontWeightRegular</div>\n  <div style=\"font-weight: ${__theme.typography.fontWeightRegular}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.fontWeightRegular}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">fontWeightMedium</div>\n  <div style=\"font-weight: ${__theme.typography.fontWeightMedium}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.fontWeightMedium}</div>\n</div>\n<div style=\"display: flex; gap: 16px; align-items: baseline; padding: 4px 0; border-bottom: 1px solid ${__theme.colors.border.weak}\">\n  <div style=\"width: 160px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">fontWeightBold</div>\n  <div style=\"font-weight: ${__theme.typography.fontWeightBold}\">The quick brown fox</div>\n  <div style=\"margin-left: auto; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">${__theme.typography.fontWeightBold}</div>\n</div>\n<p style=\"margin-top: 12px; font-family: ${__theme.typography.fontFamilyMonospace}\">\n  typography.fontFamilyMonospace: ${__theme.typography.fontFamilyMonospace}\n</p>\n",
