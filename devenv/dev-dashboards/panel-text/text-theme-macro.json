            "spec": {
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px; font-size: ${__theme.typography.size.sm}; color: ${__theme.colors.text.secondary}\">\n  <div style=\"width: 88px; flex-shrink: 0\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0\">main</div>\n  <div style=\"flex-grow: 1; flex-basis: 0\">shade</div>\n  <div style=\"flex-grow: 1; flex-basis: 0\">text</div>\n  <div style=\"flex-grow: 1; flex-basis: 0\">border</div>\n  <div style=\"flex-grow: 1; flex-basis: 0\">transparent</div>\n  <div style=\"flex-grow: 1; flex-basis: 0\">contrastText</div>\n</div>\n<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px\">\n  <div style=\"width: 88px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.primary.text}\">primary</div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.primary.main}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.primary.shade}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.primary.text}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.primary.border}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.primary.transparent}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.primary.contrastText}; border-radius: ${__theme.shape.radius.default}\"></div>\n</div>\n<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px\">\n  <div style=\"width: 88px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.secondary.text}\">secondary</div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.secondary.main}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.secondary.shade}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.secondary.text}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.secondary.border}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.secondary.transparent}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.secondary.contrastText}; border-radius: ${__theme.shape.radius.default}\"></div>\n</div>\n<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px\">\n  <div style=\"width: 88px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.info.text}\">info</div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.info.main}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.info.shade}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.info.text}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.info.border}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.info.transparent}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.info.contrastText}; border-radius: ${__theme.shape.radius.default}\"></div>\n</div>\n<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px\">\n  <div style=\"width: 88px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.success.text}\">success</div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.success.main}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.success.shade}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.success.text}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.success.border}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.success.transparent}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.success.contrastText}; border-radius: ${__theme.shape.radius.default}\"></div>\n</div>\n<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px\">\n  <div style=\"width: 88px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.warning.text}\">warning</div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.warning.main}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.warning.shade}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.warning.text}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.warning.border}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.warning.transparent}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.warning.contrastText}; border-radius: ${__theme.shape.radius.default}\"></div>\n</div>\n<div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 8px\">\n  <div style=\"width: 88px; flex-shrink: 0; font-family: ${__theme.typography.fontFamilyMonospace}; color: ${__theme.colors.error.text}\">error</div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.error.main}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.error.shade}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.error.text}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.error.border}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.error.transparent}; border-radius: ${__theme.shape.radius.default}\"></div>\n  <div style=\"flex-grow: 1; flex-basis: 0; height: 32px; background: ${__theme.colors.error.contrastText}; border-radius: ${__theme.shape.radius.default}\"></div>\n</div>\n<p style=\"color: ${__theme.colors.text.secondary}\">\n  Each swatch is <code>$&#123;__theme.colors.&lt;color&gt;.&lt;shade&gt;&#125;</code>.\n</p>\n",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Surfaces, text and borders",
          "description": "colors.background, colors.text, colors.border",
