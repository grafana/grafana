          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.2.0-local",
            "spec": {
              "options": {
                "mode": "html",
                "content": "<style>\n  .user-card {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 96px;\n    gap: 20px;\n    align-items: center;\n    margin-bottom: 12px;\n    padding: 20px;\n    overflow: hidden;\n    color: var(--theme-colors-text-primary, #d8d9da);\n    background: var(--theme-colors-background-primary, #181b1f);\n    border: 1px solid var(--theme-colors-border-weak, #2c3235);\n    border-radius: 8px;\n    box-shadow: 0 1px 2px rgb(0 0 0 / 18%);\n\n    font-family: inherit;\n  }\n\n  .user-card__header {\n    display: flex;\n    gap: 12px;\n    align-items: flex-start;\n    justify-content: space-between;\n    margin-bottom: 18px;\n  }\n\n  .user-card__name {\n    margin: 0;\n    color: var(--theme-colors-text-primary, #d8d9da);\n    font-size: 18px;\n    font-weight: 500;\n    line-height: 1.3;\n  }\n\n  .user-card__email {\n    margin-top: 4px;\n    overflow: hidden;\n    color: var(--theme-colors-text-secondary, #9fa7af);\n    font-size: 13px;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .user-card__status {\n    display: inline-flex;\n    flex: 0 0 auto;\n    gap: 6px;\n    align-items: center;\n    min-height: 24px;\n    padding: 2px 9px;\n    border-radius: 999px;\n    font-size: 12px;\n    font-weight: 500;\n  }\n\n  .user-card__status::before {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    content: \"\";\n  }\n\n  .user-card__status--active {\n    color: var(--theme-colors-success-text, #73bf69);\n    background: rgb(115 191 105 / 12%);\n    border: 1px solid rgb(115 191 105 / 28%);\n  }\n\n  .user-card__status--active::before {\n    background: var(--theme-colors-success-text, #73bf69);\n  }\n\n  .user-card__status--inactive {\n    color: var(--theme-colors-error-text, #f2495c);\n    background: rgb(242 73 92 / 12%);\n    border: 1px solid rgb(242 73 92 / 28%);\n  }\n\n  .user-card__status--inactive::before {\n    background: var(--theme-colors-error-text, #f2495c);\n  }\n\n  .user-card__metadata {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(90px, 1fr));\n    gap: 16px;\n  }\n\n  .user-card__label {\n    margin-bottom: 4px;\n    color: var(--theme-colors-text-secondary, #9fa7af);\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: 0.03em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .user-card__value {\n    overflow: hidden;\n    color: var(--theme-colors-text-primary, #d8d9da);\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.4;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .user-card__avatar {\n    width: 80px;\n    height: 80px;\n    object-fit: cover;\n    border: 1px solid var(--theme-colors-border-medium, #3d4449);\n    border-radius: 50%;\n    background: var(--theme-colors-background-secondary, #111217);\n  }\n\n  @media (max-width: 600px) {\n    .user-card {\n      grid-template-columns: minmax(0, 1fr) 64px;\n      gap: 12px;\n      padding: 16px;\n    }\n\n    .user-card__avatar {\n      width: 56px;\n      height: 56px;\n    }\n\n    .user-card__metadata {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n\n    .user-card__header {\n      flex-direction: column;\n    }\n  }\n</style>\n\n<article class=\"user-card\">\n  <div>\n    <header class=\"user-card__header\">\n      <div style=\"min-width: 0;\">\n        <h3 class=\"user-card__name\">\n          ${__data.fields.Id}\n          ${__data.fields.first_name} ${__data.fields.last_name}\n        </h3>\n\n        <div class=\"user-card__email\">\n          ${__data.fields.email}\n        </div>\n      </div>\n    </header>\n\n    <div class=\"user-card__metadata\">\n      <div>\n        <div class=\"user-card__label\">Username</div>\n        <div class=\"user-card__value\">${__data.fields.login}</div>\n      </div>\n\n      <div>\n        <div class=\"user-card__label\">Role</div>\n        <div class=\"user-card__value\">${__data.fields.role}</div>\n      </div>\n\n      <div>\n        <div class=\"user-card__label\">Last login</div>\n        <div class=\"user-card__value\">\n          ${__data.fields.last_login_date}\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <img\n    class=\"user-card__avatar\"\n    src=\"${__data.fields.photo}\" \n    alt=\"placeholder\"\n  />\n</article>",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false
                },
                "renderMode": "everyRow"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
