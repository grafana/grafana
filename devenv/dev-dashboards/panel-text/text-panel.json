          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.2.0-local",
            "spec": {
              "options": {
                "mode": "html",
                "content": "<article class=\"user-card\" style=\"display:flex;gap:20px;align-items:center;margin-bottom:12px;padding:20px;color:var(--theme-colors-text-primary, #d8d9da);background:var(--theme-colors-background-primary, #181b1f);border:1px solid var(--theme-colors-border-weak, #2c3235);border-radius:8px;box-shadow:0 1px 2px rgb(0 0 0 / 18%)\">\n  <div style=\"flex-grow:1;min-width:0\">\n    <header style=\"margin-bottom:18px\">\n      <h3 style=\"margin:0;font-size:18px;font-weight:500\">\n        ${__data.fields.Id}\n        ${__data.fields.first_name} ${__data.fields.last_name}\n      </h3>\n\n      <div style=\"margin-top:4px;color:var(--theme-colors-text-secondary, #9fa7af);font-size:13px\">${__data.fields.email}</div>\n    </header>\n\n    <div style=\"display:flex;gap:16px\">\n      <div style=\"flex-grow:1;flex-basis:90px\">\n        <div style=\"margin-bottom:4px;color:var(--theme-colors-text-secondary, #9fa7af);font-size:11px;font-weight:500;letter-spacing:0.03em;text-transform:uppercase\">Username</div>\n        <div style=\"font-size:14px;font-weight:500\">${__data.fields.login}</div>\n      </div>\n      <div style=\"flex-grow:1;flex-basis:90px\">\n        <div style=\"margin-bottom:4px;color:var(--theme-colors-text-secondary, #9fa7af);font-size:11px;font-weight:500;letter-spacing:0.03em;text-transform:uppercase\">Role</div>\n        <div style=\"font-size:14px;font-weight:500\">${__data.fields.role}</div>\n      </div>\n      <div style=\"flex-grow:1;flex-basis:90px\">\n        <div style=\"margin-bottom:4px;color:var(--theme-colors-text-secondary, #9fa7af);font-size:11px;font-weight:500;letter-spacing:0.03em;text-transform:uppercase\">Last login</div>\n        <div style=\"font-size:14px;font-weight:500\">${__data.fields.last_login_date}</div>\n      </div>\n    </div>\n  </div>\n\n  <img style=\"flex-shrink:0;width:80px;height:80px;border:1px solid var(--theme-colors-border-medium, #3d4449);border-radius:50%;background:var(--theme-colors-background-secondary, #111217)\" src=\"${__data.fields.photo}\" alt=\"placeholder\" />\n</article>",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false
                },
                "renderMode": "perRow"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
