                        "csvContent": "Id,first_name,last_name,login,last_login_date,status,role,email,photo\n1,John,Smith,j.smith,2022-11-02,active,admin,j.smith@example.com,https://pbs.twimg.com/media/HBHQeSeWMAAR1AZ.jpg\n2,Jessica,Johnson,j.johnson,2022-10-31,not active,analyst,j.johnson@example.com,https://pbs.twimg.com/media/HBHQeSeWMAAR1AZ.jpg\n3,Wei,Zhang,w.zhang,2026-08-10,Active,editor,w.zhang@example.com,https://pbs.twimg.com/media/HBHQeSeWMAAR1AZ.jpg\n4,Priya,Raman,p.raman,2026-08-09,pending,viewer,p.raman@example.com,https://pbs.twimg.com/media/HBHQeSeWMAAR1AZ.jpg\n5,\"Anne-Marie \"\"Annie\"\"\",\"van der Berg, Johannes\",a.vdberg,2026-07-04,active,admin,a.vdberg+test@example.co.uk,https://pbs.twimg.com/media/HBHQeSeWMAAR1AZ.jpg"
