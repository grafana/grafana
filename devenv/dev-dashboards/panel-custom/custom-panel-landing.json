                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "-- Dashboard --"
                      },
                      "spec": {
                        "panelId": 5,
                        "withTransforms": true
