              },
              {
                "group": ["@grafana/test-utils"],
                "message": "'@grafana/test-utils' creates a circular dependency with '@grafana/ui'"
              }
            ],
            "paths": [
              {
                "name": "react-redux",
                "importNames": ["useDispatch", "useSelector"],
                "message": "Please import from app/types/store instead."
              },
              {
                "name": "react-use",
