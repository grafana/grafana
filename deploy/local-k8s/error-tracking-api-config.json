{
  "server": {
    "bindAddress": "0.0.0.0",
    "securePort": 6443,
    "certFile": "/etc/error-tracking/certs/api.crt",
    "keyFile": "/etc/error-tracking/certs/api.key"
  },
  "auth": {
    "signingKeysURL": "http://auth-signer:8080/jwks",
    "issuer": "auth",
    "audience": "error-tracking.grafana.app"
  },
  "database": {
    "maxConnections": 4
  },
  "audit": {
    "policyFile": "/etc/error-tracking/audit/policy.yaml",
    "logPath": "-"
  }
}
