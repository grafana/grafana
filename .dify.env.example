# Copy to .dify.env and fill in your Dify Chatbot API key.
# Get it from: https://cloud.dify.ai → your Chatbot app → API Access → API Key

DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_PROXY_PORT=3456

# For iframe assistant (Publish → Embed token — NOT the API key):
DIFY_EMBED_TOKEN=
# DIFY_EMBED_BASE=https://udify.app
# DIFY_EMBED_URL=https://udify.app/chatbot/your-token
