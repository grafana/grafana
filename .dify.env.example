# SECURITY: Never commit real keys.
# 1. Copy this file → .dify.env  (gitignored)
# 2. Fill in values locally only
# 3. Restart: node scripts/assistant-dify-proxy.mjs
#
# Get API key:  https://cloud.dify.ai → app → API Access
# Get embed:    https://cloud.dify.ai → app → Publish → Embed Into Site

DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_PROXY_PORT=3456

# Iframe assistant — use ONE of these (not the API key):
DIFY_EMBED_TOKEN=
# DIFY_EMBED_BASE=https://udify.app
# DIFY_EMBED_URL=https://udify.app/chat/your-token
