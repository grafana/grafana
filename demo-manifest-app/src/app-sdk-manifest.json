{
  "apiVersion": "apps.grafana.app/v1alpha2",
  "kind": "AppManifest",
  "metadata": {
    "name": "demo-manifest-app"
  },
  "spec": {
    "appName": "demo-manifest-app",
    "appDisplayName": "Demo manifest app",
    "group": "demomanifestapp.ext.grafana.app",
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "kinds": [
          {
            "kind": "Kind",
            "plural": "Kinds",
            "scope": "Namespaced",
            "userReadable": false,
            "folderScoped": false,
            "schemas": {
              "Kind": {
                "properties": {
                  "spec": {
                    "$ref": "#/components/schemas/spec"
                  }
                },
                "required": ["spec"]
              },
              "spec": {
                "additionalProperties": false,
                "properties": {
                  "apiGroup": {
                    "description": "apiGroup is the first label of the declared kind's group. It must be a DNS label.",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                    "type": "string"
                  },
                  "name": {
                    "description": "name is the declared kind's name, such as Widget.",
                    "pattern": "^[A-Z][a-zA-Z0-9]{0,62}$",
                    "type": "string"
                  }
                },
                "required": ["apiGroup", "name"],
                "type": "object"
              }
            },
            "conversion": false
          }
        ],
        "routes": {
          "cluster": {
            "/_manifests": {
              "get": {
                "operationId": "listManifests",
                "parameters": [
                  {
                    "name": "continue",
                    "in": "query",
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "name": "limit",
                    "in": "query",
                    "schema": {
                      "type": "integer"
                    }
                  }
                ],
                "responses": {
                  "default": {
                    "description": "Default OK response",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "required": ["manifests", "continue", "apiVersion", "kind"],
                          "properties": {
                            "apiVersion": {
                              "description": "APIVersion defines the versioned schema of this representation of an object. Servers should convert recognized schemas to the latest internal value, and may reject unrecognized values. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources",
                              "type": "string"
                            },
                            "continue": {
                              "type": "string"
                            },
                            "kind": {
                              "description": "Kind is a string value representing the REST resource this object represents. Servers may infer this from the endpoint the client submits requests to. Cannot be updated. In CamelCase. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds",
                              "type": "string"
                            },
                            "manifests": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": {}
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "openapi": {
          "paths": {
            "/_manifests": {
              "get": {
                "operationId": "listManifests",
                "parameters": [
                  {
                    "in": "query",
                    "name": "continue",
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "in": "query",
                    "name": "limit",
                    "schema": {
                      "type": "integer"
                    }
                  }
                ],
                "responses": {
                  "default": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "additionalProperties": false,
                          "properties": {
                            "apiVersion": {
                              "description": "APIVersion defines the versioned schema of this representation of an object. Servers should convert recognized schemas to the latest internal value, and may reject unrecognized values. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources",
                              "type": "string"
                            },
                            "continue": {
                              "type": "string"
                            },
                            "kind": {
                              "description": "Kind is a string value representing the REST resource this object represents. Servers may infer this from the endpoint the client submits requests to. Cannot be updated. In CamelCase. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds",
                              "type": "string"
                            },
                            "manifests": {
                              "items": {
                                "additionalProperties": {},
                                "type": "object"
                              },
                              "type": "array"
                            }
                          },
                          "required": ["manifests", "continue", "apiVersion", "kind"],
                          "type": "object"
                        }
                      }
                    },
                    "description": "Default OK response"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "preferredVersion": "v1alpha1",
    "roles": {
      "demo-manifest-app:admin": {
        "title": "Demo manifest app Admin",
        "description": "Allows all actions on Kinds",
        "kinds": [
          {
            "kind": "Kind",
            "permissionSet": "admin"
          }
        ]
      },
      "demo-manifest-app:editor": {
        "title": "Demo manifest app Editor",
        "description": "Create, Read, Update, and Delete Kinds",
        "kinds": [
          {
            "kind": "Kind",
            "permissionSet": "editor"
          }
        ]
      },
      "demo-manifest-app:reader": {
        "title": "Demo manifest app Reader",
        "description": "Read Kinds",
        "kinds": [
          {
            "kind": "Kind",
            "permissionSet": "viewer"
          }
        ]
      }
    },
    "roleBindings": {
      "viewer": ["demo-manifest-app:reader"],
      "editor": ["demo-manifest-app:editor"],
      "admin": ["demo-manifest-app:admin"]
    }
  }
}
