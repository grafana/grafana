     }
 
     // Set anchor (ol < 6)
@@ -313,6 +297,30 @@ var ol_style_Photo = class olstylePhoto extends ol_style_RegularShape {
 
     return canvas
   }
+  /** Load the photo image and redraw the style when loaded
+   * @private
+   */
+  loadPhoto_() {
+    var self = this
+    var img = this.img_ = new Image()
+    this._loaded = false
+    if (this._crossOrigin) img.crossOrigin = this._crossOrigin
+    img.onload = function () {
+      if (self._loaded) return
+      self._loaded = true
+      // The loaded state is part of the cache key: force a new image with the photo
+      self.renderOptions_ = self.createRenderOptions()
+      var pixelratio = self._currentRatio
+      self._currentRatio = null
+      self.getImage(pixelratio)
+      if (self._onload) self._onload()
+    }
+    img.onerror = function () {
+      if (self._onerror) self._onerror()
+    }
+    img.src = this._src
+    if (img.complete && img.naturalWidth) this._loaded = true
+  }
   /** Returns the photo image
    * @returns {HTMLImageElement}
    */
