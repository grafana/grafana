{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // apache-arrow brings its own, newer @types/node; use the repo's.
    "typeRoots": ["../../node_modules/@types"],
    // Same alias as build.mjs: public/app/features/transformers imports app code as app/*.
    "paths": { "app/*": ["../../public/app/*"] }
  },
  "include": [
    "./src/**/*.ts",
    "./test/**/*.ts",
    "./parity/**/*.ts",
    "./bench/**/*.ts",
    "../../public/app/types/jquery/*.ts",
    "../../public/app/types/*.d.ts",
    "../../packages/grafana-ui/src/types/react-table-config.d.ts"
  ]
}
