{
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "generate": {
      "cache": true
    }
  },
  "tui": {
    "autoExit": true,
    "enabled": false
  },
  "defaultBase": "main",
  "analytics": false,
  "release": {
    "groups": {
      "grafana": {
        "projects": [
          "packages/*",
          "public/app/plugins/*/*",
          "e2e-playwright/test-plugins/*",
          "!@grafana/plugin-compat"
        ],
        "projectsRelationship": "fixed"
      },
      "plugin-compat": {
        "projects": ["@grafana/plugin-compat"],
        "projectsRelationship": "independent"
      }
    },
    "version": {
      "versionActions": "scripts/release/version-actions.ts",
      "versionPrefix": "",
      "updateDependents": "auto",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      },
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    }
  }
}
