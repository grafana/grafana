{
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "generate": {
      "cache": true
    },
    "pack:artifacts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} pack --pack-destination \"$PWD/npm-artifacts\""
      },
      "cache": false
    }
  },
  "tui": {
    "autoExit": true,
    "enabled": false
  },
  "defaultBase": "main",
  "analytics": false,
  "release": {
    "groups": {
      "grafana": {
        "projects": [
          "packages/*",
          "public/app/plugins/*/*",
          "e2e-playwright/test-plugins/*",
          "!@grafana/plugin-compat"
        ],
        "projectsRelationship": "fixed"
      }
    },
    "version": {
      "versionActions": "scripts/release/version-actions.ts",
      "versionPrefix": "",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      },
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    }
  }
}
