{
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "generate": {
      "cache": true
    }
  },
  "tui": {
    "autoExit": true,
    "enabled": false
  },
  "defaultBase": "main",
  "analytics": false,
  "release": {
    "groups": {
      "grafana": {
        "projects": [
          "@grafana/alerting",
          "@grafana/api-clients",
          "@grafana/data",
          "@grafana/e2e-selectors",
          "@grafana/flamegraph",
          "@grafana/i18n",
          "@grafana/o11y-ds-frontend",
          "@grafana/openapi",
          "@grafana/runtime",
          "@grafana/schema",
          "@grafana/sql",
          "@grafana/ui",
          "public/app/plugins/*/*"
        ],
        "projectsRelationship": "fixed"
      },
      "plugin-compat": {
        "projects": ["@grafana/plugin-compat"],
        "projectsRelationship": "independent",
        "version": {
          "conventionalCommits": true
        },
        "changelog": {
          "file": "{projectRoot}/CHANGELOG.md",
          "renderOptions": {
            "authors": false,
            "commitReferences": false,
            "versionTitleDate": true
          }
        }
      }
    },
    "version": {
      "versionActions": "scripts/release/version-actions.ts",
      "versionPrefix": "",
      "updateDependents": "auto",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      },
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false,
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      }
    }
  }
}
