{
  "apiVersion": "apps.grafana.app/v1alpha2",
  "kind": "AppManifest",
  "metadata": {
    "name": "test-app-with-sdk-manifest"
  },
  "spec": {
    "appName": "test-app-with-sdk-manifest",
    "group": "testappwithsdkmanifest.ext.grafana.app",
    "versions": [
      {
        "name": "v1",
        "kinds": [
          {
            "kind": "Thing",
            "plural": "things",
            "scope": "Namespaced",
            "schemas": {
              "Thing": {
                "type": "object",
                "properties": {
                  "spec": {
                    "type": "object",
                    "properties": {}
                  },
                  "status": {
                    "type": "object",
                    "properties": {}
                  }
                }
              }
            },
            "routes": {
              "reload": {
                "get": {
                  "operationId": "reloadThing",
                  "responses": {
                    "200": {
                      "description": "OK"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "roles": {
      "reader": {
        "title": "Thing Reader",
        "description": "Read and list things.",
        "kinds": [
          {
            "kind": "Thing",
            "permissionSet": "viewer"
          }
        ],
        "routes": [
          "reload"
        ]
      },
      "writer": {
        "title": "Thing Writer",
        "description": "Create, update and delete things.",
        "kinds": [
          {
            "kind": "Thing",
            "permissionSet": "editor"
          }
        ],
        "routes": []
      }
    },
    "roleBindings": {
      "viewer": [
        "reader"
      ],
      "editor": [
        "reader",
        "writer"
      ],
      "admin": [
        "reader",
        "writer"
      ]
    }
  }
}
